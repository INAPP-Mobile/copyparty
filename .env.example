# ================== copyparty — Railway Template ==================
# A fast, self-contained web file server / cloud-client / cloud-drive.
# Docs: https://github.com/9001/copyparty
# Anonymous reads (open file sharing) + authenticated admin writes.

# --- Railway runtime ---
# Port Railway proxies to. Must match the copyparty -p flag.
PORT=3923

# --- Required ---
# Password for the `admin` account (used for writes / uploads / management).
# Generate a long random value. The template deploy form auto-fills this
# with ${{secret(32)}} per instance; you retrieve it from your Railway vars
# after deploying. Anonymous clients remain read-only regardless.
CP_PASS=change-me-to-a-long-random-password

# --- Optional ---
# (none required — copyparty is self-contained, no external DB or S3)
